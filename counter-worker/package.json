{
  "name": "firatbarca-page-counter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply COUNTER_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply COUNTER_DB --remote",
    "deploy": "npm run db:migrate:remote && wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
